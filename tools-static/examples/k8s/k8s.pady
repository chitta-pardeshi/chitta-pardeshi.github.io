kind: Data
object: Service
records:
  - Name: api-server
    Namespace: production
    Type: ClusterIP
    ClusterIP: 10.96.10.1
    Port: "8080:8080/TCP"
    Selector: "app=api-server"
  - Name: web-frontend
    Namespace: production
    Type: ClusterIP
    ClusterIP: 10.96.10.2
    Port: "3000:3000/TCP"
    Selector: "app=web-frontend"
  - Name: redis
    Namespace: production
    Type: ClusterIP
    ClusterIP: 10.96.10.3
    Port: "6379:6379/TCP"
    Selector: "app=redis"
  - Name: postgres
    Namespace: production
    Type: ClusterIP
    ClusterIP: 10.96.10.4
    Port: "5432:5432/TCP"
    Selector: "app=postgres"
  - Name: api-server
    Namespace: staging
    Type: ClusterIP
    ClusterIP: 10.96.20.1
    Port: "8080:8080/TCP"
    Selector: "app=api-server"
  - Name: prometheus
    Namespace: monitoring
    Type: ClusterIP
    ClusterIP: 10.96.30.1
    Port: "9090:9090/TCP"
    Selector: "app=prometheus"
  - Name: grafana
    Namespace: monitoring
    Type: LoadBalancer
    ClusterIP: 10.96.30.2
    Port: "80:3000/TCP"
    Selector: "app=grafana"
  - Name: kubernetes
    Namespace: default
    Type: ClusterIP
    ClusterIP: 10.96.0.1
    Port: "443:6443/TCP"
    Selector: ""

---

kind: Data
object: Ingress
records:
  - Name: web-frontend
    Namespace: production
    Host: app.acme.com
    Path: /
    Service: web-frontend
    TLS: true
    IngressClass: nginx
  - Name: api
    Namespace: production
    Host: api.acme.com
    Path: /v2
    Service: api-server
    TLS: true
    IngressClass: nginx
  - Name: grafana
    Namespace: monitoring
    Host: grafana.internal.acme.com
    Path: /
    Service: grafana
    TLS: false
    IngressClass: nginx
  - Name: staging-web
    Namespace: staging
    Host: staging.acme.com
    Path: /
    Service: web-frontend
    TLS: false
    IngressClass: nginx

---

kind: Data
object: ConfigMap
records:
  - Name: api-config
    Namespace: production
    DataKeys: "DATABASE_URL, REDIS_URL, LOG_LEVEL, CORS_ORIGINS"
  - Name: web-config
    Namespace: production
    DataKeys: "API_URL, GA_TRACKING_ID, FEATURE_FLAGS"
  - Name: api-config
    Namespace: staging
    DataKeys: "DATABASE_URL, REDIS_URL, LOG_LEVEL, DEBUG_MODE"
  - Name: prometheus-config
    Namespace: monitoring
    DataKeys: "prometheus.yml, alert-rules.yml"
  - Name: grafana-dashboards
    Namespace: monitoring
    DataKeys: "api-dashboard.json, infra-dashboard.json, alerts-dashboard.json"
  - Name: coredns
    Namespace: kube-system
    DataKeys: "Corefile"

---

kind: Data
object: Secret
records:
  - Name: api-secrets
    Namespace: production
    SecretType: Opaque
    DataKeys: "DB_PASSWORD, JWT_SECRET, STRIPE_KEY"
  - Name: tls-acme-com
    Namespace: production
    SecretType: kubernetes.io/tls
    DataKeys: "tls.crt, tls.key"
  - Name: registry-creds
    Namespace: production
    SecretType: kubernetes.io/dockerconfigjson
    DataKeys: ".dockerconfigjson"
  - Name: api-secrets
    Namespace: staging
    SecretType: Opaque
    DataKeys: "DB_PASSWORD, JWT_SECRET"
  - Name: grafana-admin
    Namespace: monitoring
    SecretType: Opaque
    DataKeys: "admin-password"
  - Name: default-token
    Namespace: default
    SecretType: kubernetes.io/service-account-token
    DataKeys: "token, ca.crt, namespace"
