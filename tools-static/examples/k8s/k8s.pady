kind: SQL
url: schema/pad-schema.sql

---

kind: Import
url: examples/shared-prompts.pady

---

kind: Tenant
name: K8s Cluster
org_id: k8s-prod
settings:
  app.tagline: "Kubernetes Cluster Explorer"

---

kind: Schema
objects:
  - api_name: Namespace
    label: Namespace
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Status
        label: Status
        type: PICKLIST
        values: [Active, Terminating]
      - api_name: Labels
        label: Labels
        type: TEXT

  - api_name: Node
    label: Node
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Role
        label: Role
        type: PICKLIST
        values: [control-plane, worker]
      - api_name: Status
        label: Status
        type: PICKLIST
        values: [Ready, NotReady, SchedulingDisabled]
      - api_name: K8sVersion
        label: Version
        type: TEXT
      - api_name: CPU
        label: CPU Cores
        type: NUMERIC
      - api_name: MemoryGB
        label: Memory (GB)
        type: NUMERIC
      - api_name: OS
        label: OS Image
        type: TEXT
      - api_name: InternalIP
        label: Internal IP
        type: TEXT

  - api_name: Deployment
    label: Deployment
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: Deployments
      - api_name: Replicas
        label: Desired Replicas
        type: NUMERIC
      - api_name: Available
        label: Available
        type: NUMERIC
      - api_name: Image
        label: Image
        type: TEXT
      - api_name: Strategy
        label: Strategy
        type: PICKLIST
        values: [RollingUpdate, Recreate]

  - api_name: Pod
    label: Pod
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: Pods
      - api_name: Deployment
        label: Deployment
        type: LOOKUP
        target: Deployment
        relationship_name: Pods
      - api_name: Node
        label: Node
        type: LOOKUP
        target: Node
        relationship_name: Pods
      - api_name: Status
        label: Status
        type: PICKLIST
        values: [Running, Pending, Succeeded, Failed, CrashLoopBackOff, Evicted]
      - api_name: PodIP
        label: Pod IP
        type: TEXT
      - api_name: Restarts
        label: Restarts
        type: NUMERIC
      - api_name: Image
        label: Image
        type: TEXT

  - api_name: Service
    label: Service
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: Services
      - api_name: Type
        label: Type
        type: PICKLIST
        values: [ClusterIP, NodePort, LoadBalancer, ExternalName]
      - api_name: ClusterIP
        label: Cluster IP
        type: TEXT
      - api_name: Port
        label: Port
        type: TEXT
      - api_name: Selector
        label: Selector
        type: TEXT

  - api_name: Ingress
    label: Ingress
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: Ingresses
      - api_name: Host
        label: Host
        type: TEXT
      - api_name: Path
        label: Path
        type: TEXT
      - api_name: Service
        label: Backend Service
        type: LOOKUP
        target: Service
        relationship_name: Ingresses
      - api_name: TLS
        label: TLS
        type: BOOLEAN
      - api_name: IngressClass
        label: Ingress Class
        type: TEXT

  - api_name: ConfigMap
    label: ConfigMap
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: ConfigMaps
      - api_name: DataKeys
        label: Data Keys
        type: TEXT

  - api_name: Secret
    label: Secret
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Namespace
        label: Namespace
        type: LOOKUP
        target: Namespace
        relationship_name: Secrets
      - api_name: SecretType
        label: Type
        type: PICKLIST
        values: [Opaque, kubernetes.io/tls, kubernetes.io/dockerconfigjson, kubernetes.io/service-account-token]
      - api_name: DataKeys
        label: Data Keys
        type: TEXT

---

kind: Security
roles:
  - name: Cluster Admin

profiles:
  - name: System Administrator
    description: Full cluster access
    objects:
      - object: "*"
        read: true
        create: true
        edit: true
        delete: true
        view_all: true
        modify_all: true
    fields:
      - object: "*"
        field: "*"
        read: true
        edit: true

users:
  - username: admin@k8s.local
    full_name: Cluster Admin
    password: admin
    profile: System Administrator
    role: Cluster Admin

---

kind: Navigation
apps:
  - api_name: WorkloadsApp
    label: Workloads
    tabs:
      - object: Namespace
        label: Namespaces
        order: 10
      - object: Deployment
        label: Deployments
        order: 20
      - object: Pod
        label: Pods
        order: 30
    visibility:
      - profile: System Administrator
        visible: true
        default: true

  - api_name: NetworkApp
    label: Networking
    tabs:
      - object: Service
        label: Services
        order: 10
      - object: Ingress
        label: Ingresses
        order: 20
    visibility:
      - profile: System Administrator
        visible: true
        default: false

  - api_name: ConfigApp
    label: Configuration
    tabs:
      - object: ConfigMap
        label: ConfigMaps
        order: 10
      - object: Secret
        label: Secrets
        order: 20
      - object: Node
        label: Nodes
        order: 30
    visibility:
      - profile: System Administrator
        visible: true
        default: false

---

kind: Layout
layouts:
  - object: Namespace
    type: LIST
    name: Namespace List
    fields: [Name, Status, Labels]
  - object: Namespace
    type: FORM
    name: Namespace Form
    fields: [Name, Status, Labels]
  - object: Node
    type: LIST
    name: Node List
    fields: [Name, Role, Status, K8sVersion, CPU, MemoryGB]
  - object: Node
    type: FORM
    name: Node Form
    fields: [Name, Role, Status, K8sVersion, CPU, MemoryGB, OS, InternalIP]
  - object: Deployment
    type: LIST
    name: Deployment List
    fields: [Name, Namespace, Replicas, Available, Image]
  - object: Deployment
    type: FORM
    name: Deployment Form
    fields: [Name, Namespace, Replicas, Available, Image, Strategy]
  - object: Pod
    type: LIST
    name: Pod List
    fields: [Name, Namespace, Deployment, Status, Restarts]
  - object: Pod
    type: FORM
    name: Pod Form
    fields: [Name, Namespace, Deployment, Node, Status, PodIP, Restarts, Image]
  - object: Service
    type: LIST
    name: Service List
    fields: [Name, Namespace, Type, ClusterIP, Port]
  - object: Service
    type: FORM
    name: Service Form
    fields: [Name, Namespace, Type, ClusterIP, Port, Selector]
  - object: Ingress
    type: LIST
    name: Ingress List
    fields: [Name, Namespace, Host, Path, Service, TLS]
  - object: Ingress
    type: FORM
    name: Ingress Form
    fields: [Name, Namespace, Host, Path, Service, TLS, IngressClass]
  - object: ConfigMap
    type: LIST
    name: ConfigMap List
    fields: [Name, Namespace, DataKeys]
  - object: ConfigMap
    type: FORM
    name: ConfigMap Form
    fields: [Name, Namespace, DataKeys]
  - object: Secret
    type: LIST
    name: Secret List
    fields: [Name, Namespace, SecretType, DataKeys]
  - object: Secret
    type: FORM
    name: Secret Form
    fields: [Name, Namespace, SecretType, DataKeys]

assignments:
  - profile: System Administrator
    record_type: "*"
    layout_type: FORM

---

kind: Data
object: Namespace
records:
  - Name: default
    Status: Active
    Labels: "kubernetes.io/metadata.name=default"
  - Name: kube-system
    Status: Active
    Labels: "kubernetes.io/metadata.name=kube-system"
  - Name: kube-public
    Status: Active
    Labels: "kubernetes.io/metadata.name=kube-public"
  - Name: production
    Status: Active
    Labels: "env=production, team=platform"
  - Name: staging
    Status: Active
    Labels: "env=staging, team=platform"
  - Name: monitoring
    Status: Active
    Labels: "env=production, team=sre"

---

