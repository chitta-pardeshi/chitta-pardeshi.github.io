---

kind: Data
object: Deployment
records:
  - Name: api-server
    Namespace: production
    Replicas: 3
    Available: 3
    Image: acme/api-server:v2.4.1
    Strategy: RollingUpdate
  - Name: web-frontend
    Namespace: production
    Replicas: 2
    Available: 2
    Image: acme/web-frontend:v3.1.0
    Strategy: RollingUpdate
  - Name: worker
    Namespace: production
    Replicas: 5
    Available: 5
    Image: acme/worker:v2.4.1
    Strategy: RollingUpdate
  - Name: api-server
    Namespace: staging
    Replicas: 1
    Available: 1
    Image: acme/api-server:v2.5.0-rc1
    Strategy: RollingUpdate
  - Name: web-frontend
    Namespace: staging
    Replicas: 1
    Available: 1
    Image: acme/web-frontend:v3.2.0-rc1
    Strategy: RollingUpdate
  - Name: redis
    Namespace: production
    Replicas: 3
    Available: 3
    Image: redis:7.2-alpine
    Strategy: RollingUpdate
  - Name: postgres
    Namespace: production
    Replicas: 2
    Available: 2
    Image: postgres:16.2-alpine
    Strategy: Recreate
  - Name: prometheus
    Namespace: monitoring
    Replicas: 1
    Available: 1
