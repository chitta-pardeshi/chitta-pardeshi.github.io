    Strategy: Recreate
  - Name: grafana
    Namespace: monitoring
    Replicas: 1
    Available: 1
    Image: grafana/grafana:10.3.1
    Strategy: RollingUpdate
  - Name: coredns
    Namespace: kube-system
    Replicas: 2
    Available: 2
    Image: registry.k8s.io/coredns/coredns:v1.11.1
    Strategy: RollingUpdate

---

