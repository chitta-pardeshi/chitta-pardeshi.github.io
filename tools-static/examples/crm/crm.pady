kind: SQL
url: schema/pad-schema.sql

---

kind: Import
url: examples/shared-prompts.pady

---

kind: Tenant
name: Acme CRM
org_id: ORG-CRM-001
settings:
  app.tagline: "Sales & Service CRM"

---

kind: Schema
objects:
  - api_name: Account
    label: Account
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: Industry
        label: Industry
        type: PICKLIST
        values: [Technology, Healthcare, Finance, Manufacturing, Retail]
      - api_name: Revenue
        label: Revenue
        type: NUMERIC
      - api_name: Active
        label: Active
        type: BOOLEAN

  - api_name: Contact
    label: Contact
    fields:
      - api_name: FirstName
        label: First Name
        type: TEXT
      - api_name: LastName
        label: Last Name
        type: TEXT
        is_name: true
      - api_name: Email
        label: Email
        type: TEXT
      - api_name: AccountId
        label: Account
        type: LOOKUP
        target: Account
        relationship_name: Contacts

  - api_name: Opportunity
    label: Opportunity
    fields:
      - api_name: Name
        label: Name
        type: TEXT
        is_name: true
      - api_name: AccountId
        label: Account
        type: LOOKUP
        target: Account
        relationship_name: Opportunities
      - api_name: Amount
        label: Amount
        type: NUMERIC
      - api_name: Stage
        label: Stage
        type: PICKLIST
        values: [Prospecting, Qualification, Proposal, Negotiation, Closed Won, Closed Lost]
      - api_name: CloseDate
        label: Close Date
        type: DATE

  - api_name: Activity
    label: Activity
    fields:
      - api_name: Subject
        label: Subject
        type: TEXT
        is_name: true
      - api_name: RelatedTo
        label: Related To
        type: LOOKUP
        target: Opportunity
        relationship_name: Activities
      - api_name: Type
        label: Type
        type: PICKLIST
        values: [Call, Email, Meeting, Task]
      - api_name: ActivityDate
        label: Date
        type: DATETIME

  - api_name: Case
    label: Case
    fields:
      - api_name: Subject
        label: Subject
        type: TEXT
        is_name: true
      - api_name: AccountId
        label: Account
        type: LOOKUP
        target: Account
        relationship_name: Cases
      - api_name: Priority
        label: Priority
        type: PICKLIST
        values: [Low, Medium, High, Critical]
      - api_name: Status
        label: Status
        type: PICKLIST
        values: [New, In Progress, Escalated, Resolved, Closed]

  - api_name: KBArticle
    label: KB Article
    fields:
      - api_name: Title
        label: Title
        type: TEXT
        is_name: true
      - api_name: Body
        label: Body
        type: TEXT
      - api_name: Category
        label: Category
        type: PICKLIST
        values: [FAQ, How-To, Troubleshooting, Release Notes]
      - api_name: Published
        label: Published
        type: BOOLEAN

---

kind: Security
roles:
  - name: CEO
  - name: VP Sales
    parent: CEO
  - name: Sales Rep
    parent: VP Sales

profiles:
  - name: System Administrator
    description: Full access to all objects and configuration
    objects:
      - object: "*"
        read: true
        create: true
        edit: true
        delete: true
        view_all: true
        modify_all: true
    fields:
      - object: "*"
        field: "*"
        read: true
        edit: true

  - name: Sales Rep
    description: Full CRM access, read-only Cases and KB Articles
    objects:
      - object: Account
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
      - object: Contact
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
      - object: Opportunity
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
      - object: Activity
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
      - object: Case
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
      - object: KBArticle
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
    fields:
      - object: Account
        field: "*"
        read: true
        edit: true
      - object: Contact
        field: "*"
        read: true
        edit: true
      - object: Opportunity
        field: "*"
        read: true
        edit: true
      - object: Activity
        field: "*"
        read: true
        edit: true
      - object: Case
        field: "*"
        read: true
        edit: false
      - object: KBArticle
        field: "*"
        read: true
        edit: false

  - name: Support Agent
    description: Full Cases and KB access, read-only CRM
    objects:
      - object: Account
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
      - object: Contact
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
      - object: Opportunity
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
      - object: Activity
        read: true
        create: false
        edit: false
        delete: false
        view_all: false
        modify_all: false
      - object: Case
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
      - object: KBArticle
        read: true
        create: true
        edit: true
        delete: true
        view_all: false
        modify_all: false
    fields:
      - object: Account
        field: "*"
        read: true
        edit: false
      - object: Contact
        field: "*"
        read: true
        edit: false
      - object: Opportunity
        field: "*"
        read: true
        edit: false
      - object: Activity
        field: "*"
        read: true
        edit: false
      - object: Case
        field: "*"
        read: true
        edit: true
      - object: KBArticle
        field: "*"
        read: true
        edit: true

users:
  - username: admin@acme.com
    full_name: System Admin
    password: admin
    profile: System Administrator
    role: CEO
  - username: alice@acme.com
    full_name: Alice Johnson
    password: alice
    profile: Sales Rep
    role: Sales Rep
  - username: bob@acme.com
    full_name: Bob Smith
    password: bob
    profile: Support Agent
    role: Sales Rep

---

kind: Navigation
apps:
  - api_name: SalesApp
    label: Sales
    tabs:
      - object: Account
        label: Accounts
        order: 10
      - object: Contact
        label: Contacts
        order: 20
      - object: Opportunity
        label: Opportunities
        order: 30
      - object: Activity
        label: Activities
        order: 40
    visibility:
      - profile: System Administrator
        visible: true
        default: true
      - profile: Sales Rep
        visible: true
        default: true

  - api_name: ServiceApp
    label: Service
    tabs:
      - object: Case
        label: Cases
        order: 10
      - object: KBArticle
        label: KB Articles
        order: 20
      - object: Account
        label: Accounts
        order: 30
    visibility:
      - profile: System Administrator
        visible: true
        default: false
      - profile: Support Agent
        visible: true
        default: true

---

kind: Layout
layouts:
  - object: Account
    type: LIST
    name: Account List
    fields: [Name, Industry, Revenue, Active]
  - object: Account
    type: FORM
    name: Account Form
    fields: [Name, Industry, Revenue, Active]
  - object: Contact
    type: LIST
    name: Contact List
    fields: [FirstName, LastName, Email, AccountId]
  - object: Contact
    type: FORM
    name: Contact Form
    fields: [FirstName, LastName, Email, AccountId]
  - object: Opportunity
    type: LIST
    name: Opportunity List
    fields: [Name, AccountId, Amount, Stage]
  - object: Opportunity
    type: FORM
    name: Opportunity Form
    fields: [Name, AccountId, Amount, Stage, CloseDate]
  - object: Activity
    type: LIST
    name: Activity List
    fields: [Subject, RelatedTo, Type]
  - object: Activity
    type: FORM
    name: Activity Form
    fields: [Subject, RelatedTo, Type, ActivityDate]
  - object: Case
    type: LIST
    name: Case List
    fields: [Subject, AccountId, Priority, Status]
  - object: Case
    type: FORM
    name: Case Form
    fields: [Subject, AccountId, Priority, Status]
  - object: KBArticle
    type: LIST
    name: KB Article List
    fields: [Title, Category, Published]
  - object: KBArticle
    type: FORM
    name: KB Article Form
    fields: [Title, Body, Category, Published]

assignments:
  - profile: System Administrator
    record_type: "*"
    layout_type: FORM
  - profile: Sales Rep
    record_type: "*"
    layout_type: FORM
  - profile: Support Agent
    record_type: "*"
    layout_type: FORM

---

kind: Rules
rules:
  # Validation: Revenue cannot be negative
  - name: Revenue must be positive
    parent: Account
    type: VALIDATION
    trigger: ON_CREATE
    criteria:
      conditions:
        - field: Revenue
          op: LESS_THAN
          value: 0
    action:
      type: REJECT
      message: "Revenue cannot be negative"

  # Validation: Email required on Contact
  - name: Email required
    parent: Contact
    type: VALIDATION
    trigger: ON_CREATE
    criteria:
      conditions:
        - field: Email
          op: IS_NULL
    action:
      type: REJECT
      message: "Email is required for contacts"

  # State transition: Opportunity stage gates
  - name: Opportunity stage gates
    parent: Opportunity
    type: STATE_TRANSITION
    trigger: ON_UPDATE
    action:
      type: STATE_TRANSITION
      field: Stage
      transitions:
        Prospecting: [Qualification, Closed Lost]
        Qualification: [Proposal, Closed Lost]
        Proposal: [Negotiation, Closed Lost]
        Negotiation: [Closed Won, Closed Lost]
      message: "Cannot move from {old} to {new}"

  # Field update: Default priority on new cases
  - name: Default case priority
    parent: Case
    type: FIELD_UPDATE
    trigger: ON_CREATE
    target_field: Priority
    action:
      type: SET_FIELD
      value: Medium

  # Data Quality rules are auto-generated on first audit run

